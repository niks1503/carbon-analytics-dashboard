# Environment Variables — Carbon & ESG Analytics Dashboard
# Copy this file to .env and fill in your values.
# The .env file is git-ignored and must NEVER be committed.

# ─────────────────────────────────────────────
# Google Gemini API (GenAI C-Suite Insights)
# Get your key at: https://aistudio.google.com/app/apikey
# Leave blank to use the built-in deterministic fallback engine.
# ─────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ─────────────────────────────────────────────
# Google Cloud BigQuery (Live Data Source)
# Leave blank to use the anonymized synthetic CSV dataset.
# ─────────────────────────────────────────────
GCP_PROJECT_ID=your-gcp-project-id
BIGQUERY_DATASET=esg_carbon_mart
BIGQUERY_TABLE=anonymized_carbon_footprint_monthly

# Path to your GCP service account JSON key file (for local dev).
# On Cloud Run, use Workload Identity Federation instead.
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service_account.json
